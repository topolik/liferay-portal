<?xml version="1.0"?>
<!DOCTYPE routes PUBLIC "-//Liferay//DTD Friendly URL Routes 7.0.0//EN" "http://www.liferay.com/dtd/liferay-friendly-url-routes_7_0_0.dtd">

<routes>
	<route>
		<pattern>/openid_connect_request</pattern>
		<implicit-parameter name="javax.portlet.action">/login/openid_connect_request</implicit-parameter>
		<implicit-parameter name="p_p_lifecycle">1</implicit-parameter>
	</route>
	<route>
		<pattern>/openid_connect/{error}</pattern>
		<implicit-parameter name="mvcRenderCommandName">/login/openid_connect_request</implicit-parameter>
		<implicit-parameter name="p_p_lifecycle">0</implicit-parameter>
		<implicit-parameter name="p_p_state">maximized</implicit-parameter>
	</route>
</routes>