<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.liferay.portal.osgi</groupId>
	<artifactId>cxf-rt-ws-policy-patch</artifactId>
	<version>1.0.0</version>
	<packaging>bundle</packaging>

	<properties>
		<cxf.version>3.0.0-milestone2</cxf.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-core</artifactId>
            <version>${cxf.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-ws-policy</artifactId>
            <version>${cxf.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>3.1.1.RELEASE</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<encoding>UTF-8</encoding>
					<source>1.6</source>
					<target>1.6</target>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<configuration>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>1.4.0</version>
				<extensions>true</extensions>
				<configuration>
					<instructions>
						<Bundle-SymbolicName>org.apache.cxf.cxf-rt-ws-policy.patched</Bundle-SymbolicName>
						<Bundle-Name>${project.artifactId}</Bundle-Name>
						<Bundle-Version>${cxf.version}</Bundle-Version>
                        <Fragment-Host>org.apache.cxf.cxf-rt-ws-policy</Fragment-Host>
                        <Private-Package>
                            org.apache.cxf.ws.policy.attachment.external;-split-package:=merge-last
                        </Private-Package>
						<Export-Package>
                            org.apache.cxf.ws.policy.attachment.external.patched;version="${cxf.version}"
                        </Export-Package>
                        <Import-Package>
                            org.apache.cxf;version="${cxf.version}",
                            org.apache.cxf.ws.policy.attachment.external;version="${cxf.version}",
                            org.springframework.core.io;version="0.0.0"
                        </Import-Package>
					</instructions>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>